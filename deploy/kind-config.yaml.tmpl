kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: eval
networking:
  disableDefaultCNI: true      # kindnet does not enforce NetworkPolicy; `make kind-up` installs Calico instead
  podSubnet: 192.168.0.0/16
nodes:
  - role: control-plane
    extraMounts:
      # host ./data  ->  node /eval-data  ->  runner pod /data  (see deploy/k8s/overlays/kind)
      - hostPath: ${EVAL_DATA_DIR}
        containerPath: /eval-data
